    "print(f\"Resume length stats: mean={df_model['resume_length'].mean():.0f}, median={df_model['resume_length'].median():.0f}\")\n",
    "print(f\"Job length stats: mean={df_model['job_length'].mean():.0f}, median={df_model['job_length'].median():.0f}\")\n",
    "\n",
    "# Matched score distribution\n",
    "plt.figure(figsize=(14, 5))\n",
    "\n",
    "plt.subplot(1, 2, 1)\n",
